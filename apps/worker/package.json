{
  "name": "@ai-neobank/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "RUN_WORKER_INTEGRATION=1 vitest run src/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-neobank/database": "workspace:*",
    "@ai-neobank/evm-adapter": "workspace:*",
    "@ai-neobank/signer": "workspace:*",
    "@ai-neobank/solana-adapter": "workspace:*",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": { "@types/node": "^22.18.1", "tsx": "^4.20.5", "vitest": "^3.2.4" }
}
