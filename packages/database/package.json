{
  "name": "@ai-neobank/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:integration": "RUN_DATABASE_INTEGRATION=1 vitest run src/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ai-neobank/domain": "workspace:*",
    "postgres": "^3.4.7",
    "@ai-neobank/policy": "workspace:*",
    "bs58": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
