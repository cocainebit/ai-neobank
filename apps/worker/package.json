{
  "name": "@ai-neobank/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:integration": "RUN_WORKER_INTEGRATION=1 vitest run --no-file-parallelism src/integration.test.ts src/governance.test.ts src/x402.test.ts src/receivables.test.ts src/keys.test.ts src/recovery.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rotate-keys": "tsx src/rotate-keys.ts"
  },
  "dependencies": {
    "@ai-neobank/database": "workspace:*",
    "@ai-neobank/evm-adapter": "workspace:*",
    "@ai-neobank/signer": "workspace:*",
    "@ai-neobank/solana-adapter": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "@ai-neobank/chain-core": "workspace:*",
    "@ai-neobank/domain": "workspace:*",
    "@ai-neobank/safe-adapter": "workspace:*",
    "@ai-neobank/squads-adapter": "workspace:*",
    "@ai-neobank/x402-adapter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4",
    "@solana/spl-token": "^0.4.14",
    "viem": "^2.37.3"
  },
  "exports": {
    ".": {
      "types": "./src/worker.ts",
      "default": "./dist/worker.js"
    }
  }
}
