{
  "name": "ai-neobank",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @ai-neobank/web dev",
    "dev:api": "pnpm --filter @ai-neobank/api dev",
    "dev:worker": "pnpm --filter @ai-neobank/worker dev",
    "localnet": "scripts/localnet.sh up",
    "localnet:down": "scripts/localnet.sh down",
    "migrate": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay pnpm --filter @ai-neobank/database migrate",
    "test": "turbo test",
    "test:integration": "pnpm migrate && pnpm test:integration:database && pnpm test:integration:evm && pnpm test:integration:solana && pnpm test:integration:safe && pnpm test:integration:squads && pnpm test:integration:x402 && pnpm test:integration:worker && pnpm test:integration:api",
    "test:integration:database": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_DATABASE_INTEGRATION=1 pnpm --filter @ai-neobank/database test:integration",
    "test:integration:evm": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_CHAIN_INTEGRATION=1 pnpm --filter @ai-neobank/evm-adapter test:integration",
    "test:integration:solana": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_CHAIN_INTEGRATION=1 pnpm --filter @ai-neobank/solana-adapter test:integration",
    "test:integration:worker": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_WORKER_INTEGRATION=1 pnpm --filter @ai-neobank/worker test:integration",
    "test:integration:api": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_API_INTEGRATION=1 pnpm --filter @ai-neobank/api test:integration",
    "test:integration:safe": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_SAFE_INTEGRATION=1 pnpm --filter @ai-neobank/safe-adapter test:integration",
    "typecheck": "turbo typecheck",
    "test:integration:squads": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_SQUADS_INTEGRATION=1 pnpm --filter @ai-neobank/squads-adapter test:integration",
    "test:integration:x402": "DATABASE_URL=postgres://relay@127.0.0.1:8723/relay EVM_RPC_URL=http://127.0.0.1:8722 SOLANA_RPC_URL=http://127.0.0.1:8724 RUN_X402_INTEGRATION=1 pnpm --filter @ai-neobank/x402-adapter test:integration"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
