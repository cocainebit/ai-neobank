NODE_ENV=development
RELAY_ENVIRONMENT=development
HOST=127.0.0.1
PORT=8720
# scripts/localnet.sh up starts Postgres, Anvil, and a Solana validator on this repo's port block.
DATABASE_URL=postgres://relay@127.0.0.1:8723/relay
# Where the API is reached and which origin the browser app runs on.
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:8721
WEB_ORIGIN=http://localhost:8721
# Signer data keys are wrapped by a versioned keyring (development) or AWS KMS (production).
# Keyring entries are version:hex, e.g. "1:$(openssl rand -hex 32)". SIGNER_MASTER_KEY is the legacy single-key form.
SIGNER_KEYRING=
SIGNER_ACTIVE_KEY_VERSION=
SIGNER_MASTER_KEY=
# Production: wrap data keys with this KMS key, and/or enable EVM signers held in KMS.
KMS_DATA_KEY_ID=
KMS_SIGNING=false
AWS_REGION=
ALLOW_SOFTWARE_SIGNERS=false
# Local chains only: Safe singletons and a test token deployed by scripts/localnet.sh.
LOCAL_FIXTURES_FILE=
EVM_RPC_URL=http://127.0.0.1:8722
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=1
SOLANA_RPC_URL=http://127.0.0.1:8724
SOLANA_NETWORK=solana:localnet
SOLANA_FINALITY=finalized
WORKER_POLL_MS=500
SYNC_INTERVAL_MS=15000
SCHEDULE_INTERVAL_MS=30000
EVM_MAX_BLOCKS_PER_SYNC=2000
# Optional: a hosted x402 facilitator for paying invoices over x402 (CDP in production).
X402_FACILITATOR_URL=
# Web console (apps/web). NEXT_PUBLIC_DEV_WALLET enables in-browser development wallets on local chains.
RELAY_API_URL=http://127.0.0.1:8720
NEXT_PUBLIC_DEV_WALLET=0
NEXT_PUBLIC_DEV_EVM_RPC_URL=http://127.0.0.1:8722
