{
  "name": "@ai-neobank/safe-adapter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:integration": "RUN_SAFE_INTEGRATION=1 vitest run src/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@safe-global/protocol-kit": "^6.1.1",
    "@safe-global/types-kit": "^3.0.0",
    "viem": "^2.37.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.1",
    "@safe-global/safe-contracts": "1.4.1",
    "vitest": "^3.2.4",
    "@ai-neobank/evm-adapter": "workspace:*"
  }
}
