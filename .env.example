NODE_ENV=development
RELAY_ENVIRONMENT=development
HOST=127.0.0.1
PORT=8720
# scripts/localnet.sh up starts Postgres, Anvil, and a Solana validator on this repo's port block.
DATABASE_URL=postgres://relay@127.0.0.1:8723/relay
# Where the API is reached and which origin the browser app runs on.
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:8721
WEB_ORIGIN=http://localhost:8721
# Development only: 32 random bytes as 64 hex characters. Generate with: openssl rand -hex 32
SIGNER_MASTER_KEY=
ALLOW_SOFTWARE_SIGNERS=false
EVM_RPC_URL=http://127.0.0.1:8722
EVM_CHAIN_ID=31337
EVM_CONFIRMATIONS=1
SOLANA_RPC_URL=http://127.0.0.1:8724
SOLANA_NETWORK=solana:localnet
SOLANA_FINALITY=finalized
WORKER_POLL_MS=500
